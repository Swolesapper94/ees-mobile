# true: local demonstration data; false: shared MERIT backend records.
VITE_EES_DEMO_MODE=true

# Existing MERIT Express backend. Include the mobile origin in backend CORS.
VITE_EES_API_URL=http://localhost:4000

# Used to locate the standard Supabase browser session when production mode is enabled.
# Deploy mobile under the same origin as MERIT web so the authenticated session is shared.
VITE_SUPABASE_URL=
